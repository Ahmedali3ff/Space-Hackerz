# ASTRA — Environment Variables Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real values.

# ── Astro-AI Assistant ──────────────────────────────────────────────────────
# The application works fully without these values (static knowledge base fallback).
# SECURITY: never put the provider key in a VITE_* variable — VITE_* values are bundled
# into the browser. AI calls go through the server proxy at /api/ai instead.

# Frontend: set to 'true' to route AI requests through the server proxy
VITE_AI_PROXY=false

# Server only (never exposed to the browser):
AI_API_KEY=
# e.g. https://api.openai.com/v1/chat/completions
AI_API_ENDPOINT=
AI_MODEL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to sign session tokens. REQUIRED in production (use a long random string).
AUTH_SECRET=

# ── Feature Flags (optional) ────────────────────────────────────────────────
# Set to 'true' to enable features that are not yet production-ready

# Enable Phaser game canvas (set to 'false' to use static placeholder during development)
VITE_ENABLE_PHASER=true

# Enable Astro-AI panel (set to 'false' to hide while AI integration is incomplete)
VITE_ENABLE_ASTRO_AI=true

# ── Backend API ─────────────────────────────────────────────────────────────────
# URL of the Space+ Express/SQLite backend. The app works fully offline without it.
VITE_API_URL=http://localhost:3001
