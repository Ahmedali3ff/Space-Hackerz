# ASTRA — Environment Variables Template
# Copy this file to .env and fill in actual values.
# NEVER commit .env with real values.

# ── Astro-AI Assistant ──────────────────────────────────────────────────────
# The application works fully without these values.
# Astro-AI falls back to the static knowledge base when these are absent.

# Your AI service API key
VITE_AI_API_KEY=

# Your AI service endpoint (e.g. https://api.openai.com/v1)
VITE_AI_API_ENDPOINT=

# Model identifier (e.g. gpt-4o, claude-3-5-haiku-20241022)
VITE_AI_MODEL=

# ── Feature Flags (optional) ────────────────────────────────────────────────
# Set to 'true' to enable features that are not yet production-ready

# Enable Phaser game canvas (set to 'false' to use static placeholder during development)
VITE_ENABLE_PHASER=true

# Enable Astro-AI panel (set to 'false' to hide while AI integration is incomplete)
VITE_ENABLE_ASTRO_AI=true

# ── Backend API ─────────────────────────────────────────────────────────────────
# URL of the Space+ Express/SQLite backend. The app works fully offline without it.
VITE_API_URL=http://localhost:3001
